# Copy this file to .env and fill in your key. NEVER commit .env.
# Real environment variables take precedence over this file.

# --- Current development provider: Groq -------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# --- Alternative providers (LLM_PROVIDER selects) ---------------------------
# OpenRouter (https://openrouter.ai/keys):
#   LLM_PROVIDER=openrouter
#   OPENROUTER_API_KEY=
# OpenAI directly (https://platform.openai.com/api-keys):
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=
#
# Optional explicit overrides (any provider):
#   LLM_BASE_URL=   (OpenAI-compatible endpoint; normally not needed)
#   LLM_MODEL=      (defaults: groq=openai/gpt-oss-120b,
#                     openrouter=openai/gpt-4o-mini, openai=gpt-4o-mini)

# --- Web API server (python -m rf_catalogue.api / docker compose) -----------
# CORS_ORIGINS: comma-separated browser origins allowed to call the API.
# Leave empty in Docker (same-origin via the nginx proxy). For local dev the
# defaults cover the Vite dev server (localhost:5173 / :3000).
#CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Bind host/port for `python -m rf_catalogue.api` (defaults 127.0.0.1:8000).
#API_HOST=127.0.0.1
#API_PORT=8000
# Idle seconds before a web conversation session is dropped (default 7200).
#SESSION_TTL=7200
